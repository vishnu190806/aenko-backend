# AENKO backend configuration reference
# Template only: Spring Boot does not automatically load .env files by default.
# Configure these through your IDE, shell environment, or hosting dashboard.

# Database
DB_URL=jdbc:mysql://localhost:3306/aenko
DB_USERNAME=your_local_database_username
DB_PASSWORD=replace_with_your_local_database_password

# Security
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters

# Frontend CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI provider: ollama for local development or gemini for cloud AI
AI_ENABLED=true
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=your_local_ollama_model_name

# For Gemini, configure AI_PROVIDER=gemini and use the provider defaults
# or the documented Gemini base URL and a supported model.
# Set GEMINI_API_KEY securely in your environment.
# Never commit the real API key.
